# Modelo de configuração. NÃO coloque chaves reais neste arquivo!
# Copie para .env (que o git ignora) e preencha na sua máquina:
#   cp .env.exemplo .env
#
# Chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=

# Provedor de IA da sua preferência: anthropic | openai | ollama
FISCALIZA_LLM=anthropic
# Chave do provedor escolhido (só a que for usar):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Para ollama (IA local, sem chave), opcionalmente:
# OLLAMA_HOST=http://localhost:11434
# FISCALIZA_LLM_MODELO=llama3.1
